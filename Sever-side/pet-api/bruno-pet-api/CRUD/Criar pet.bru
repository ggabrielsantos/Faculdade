meta {
  name: Criar pet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome_pet": "Gazela",
    "genero_pet": "M"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("codigo", res.body.codigo_pet);
}
